{
  "name": "Hishobh - Personal Expense Tracker",
  "short_name": "Hishobh",
  "description": "Fast personal expense tracker PWA for seamless synchronization between mobile and desktop.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#FFFFFF",
  "theme_color": "#7E30E1",
  "orientation": "any",
  "categories": ["finance", "productivity", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Open your personal expense dashboard",
      "url": "/dashboard",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Analytics & Stats",
      "short_name": "Analytics",
      "description": "View spending insights, trends, and category breakdowns",
      "url": "/stats",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Accounts & Cards",
      "short_name": "Accounts",
      "description": "Manage bank accounts, wallets, and balances",
      "url": "/accounts",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Lend & Borrow",
      "short_name": "Debts",
      "description": "View loan counterparty ledgers and settlements",
      "url": "/settings/lend-borrow",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    }
  ]
}
